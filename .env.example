# 로컬 Node 직접 실행 및 로컬 Docker 검수 기본값입니다.
# 실제 운영/production 검수 때만 NODE_ENV=production으로 바꾸고 아래 production secret 요구사항을 만족하는 값을 설정하세요.
NODE_ENV=development
PORT=25570

# 로컬 Node 직접 실행용 DATABASE_URL입니다.
# Docker Compose app 컨테이너 내부에서는 localhost가 아니라 postgres 서비스명을 사용하도록 docker-compose.yml에서 덮어씁니다.
DATABASE_URL=postgresql://seiga:seiga_password@localhost:5432/seiga_db

# Docker Compose Postgres 기본값입니다. 운영 배포 전 반드시 강한 값으로 교체하세요.
POSTGRES_DB=seiga_db
POSTGRES_USER=seiga
POSTGRES_PASSWORD=seiga_password

# 개발용 placeholder입니다. production에서는 그대로 사용하면 서버가 시작되지 않습니다.
# production 요구사항:
# - SESSION_SECRET: 32자 이상, placeholder/dev/example 계열 금지, 문자 종류 2개 이상
# - TOKEN_ENCRYPTION_SECRET: 32자 이상, placeholder/dev/example 계열 금지, 문자 종류 2개 이상
# - ADMIN_PASSWORD: 12자 이상, 대문자/소문자/숫자/특수문자 포함
SESSION_SECRET=change-me-session-secret
TOKEN_ENCRYPTION_SECRET=change-me-32-byte-secret
SESSION_STORE=database
SESSION_COOKIE_DAYS=7
REMEMBER_ME_DAYS=30

# 샘플 스트리머/스냅샷/페이지뷰 생성 여부입니다. 운영 환경과 Docker 기본 실행에서는 false를 권장합니다.
SEED_SAMPLE_DATA=false
# 관리자 계정 bootstrap 여부입니다. 최초 관리자 생성이 필요하면 true로 둡니다.
SEED_BOOTSTRAP_ADMIN=true
# true로 설정할 때만 기존 관리자 비밀번호를 ADMIN_PASSWORD 값으로 갱신합니다.
ADMIN_RESET_PASSWORD_ON_SEED=false

ADMIN_EMAIL=admin@example.com
# 개발용 placeholder입니다. production에서는 강한 관리자 초기 비밀번호로 교체하세요.
ADMIN_PASSWORD=change-me-admin-password

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:25570/auth/twitch/callback

UPLOAD_DIR=uploads
# 대표 이미지와 배경/커버 이미지에 공통 적용되는 최대 업로드 크기(MB)입니다.
MAX_AVATAR_UPLOAD_MB=3
# 오버레이 알림 이미지/GIF asset 업로드 최대 크기(MB)입니다.
MAX_OVERLAY_ASSET_UPLOAD_MB=10
PUBLIC_BASE_URL=http://localhost:25570

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
